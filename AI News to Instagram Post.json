      ]
    },
    {
      "parameters": {
        "operation": "news",
        "query": "artificial intelligence AI news",
        "count": 5,
        "additionalParameters": {
          "freshness": "pd"
        }
      },
      "id": "bb2233a5-049c-4d6b-af0a-a485824f862d",
      "name": "Get Latest AI News",
      "type": "@brave/n8n-nodes-brave-search.braveSearch",
      "typeVersion": 1.1,
      "position": [
        48,
        0
      ],
      "credentials": {
        "braveSearchApi": {
          "id": null,
          "name": "Gateway credits",
          "__aiGatewayManaged": true
        }
      }
    },
    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-5-mini",
          "cachedResultName": "GPT-5-MINI"
        },
        "responses": {
          "values": [
            {
              "content": "=Here are today's latest AI news results (JSON):\n{{ JSON.stringify($input.all().map(i => i.json)).slice(0, 6000) }}\n\nPick the single most interesting story. Return JSON with:\n- \"caption\": an engaging Instagram caption (max 1200 characters) summarizing the news in simple words, with 1-2 emojis and 8-12 relevant hashtags at the end.\n- \"image_prompt\": a short, vivid prompt (max 300 characters) for an eye-catching square social media image about this story. No text or logos in the image."
            }
          ]
        },
        "builtInTools": {},
        "options": {
          "textFormat": {
            "textOptions": {
              "type": "json_schema",
              "name": "instagram_post",
              "schema": "{\"type\":\"object\",\"properties\":{\"caption\":{\"type\":\"string\"},\"image_prompt\":{\"type\":\"string\"}},\"required\":[\"caption\",\"image_prompt\"],\"additionalProperties\":false}",
              "strict": true
            }
          }
        }
      },
      "id": "aaabc11b-0268-4f03-91ea-fb11846693b9",
      "name": "Write Caption and Image Prompt",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 2.3,
      "position": [
        304,
        0
      ],
      "executeOnce": true,
      "credentials": {
        "openAiApi": {
          "id": null,
          "name": "Gateway credits",
          "__aiGatewayManaged": true
        }
      }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "caption",
              "name": "caption",
              "type": "string",
              "value": "={{ $json.output[0].content[0].text.caption }}"
            },
            {
              "id": "image_url",
              "name": "image_url",
              "type": "string",
              "value": "=https://image.pollinations.ai/prompt/{{ encodeURIComponent($json.output[0].content[0].text.image_prompt) }}?width=1080&height=1080&nologo=true&seed={{ $now.toMillis() }}"
            }
          ]
        },
        "options": {}
      },
      "id": "72e09628-29d6-47dd-b2fa-3e52d4a45417",
      "name": "Create Image URL",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        672,
        0
      ]
    },
    {
      "parameters": {
        "httpRequestMethod": "POST",
        "graphApiVersion": "v23.0",
        "node": "<__PLACEHOLDER_VALUE__Instagram Business Account ID__>",
        "edge": "media",
        "options": {
          "queryParameters": {
            "parameter": [
              {
                "name": "image_url",
                "value": "={{ $json.image_url }}"
              },
              {
                "name": "caption",
                "value": "={{ $json.caption }}"
              }
            ]
          }
        }
      },
